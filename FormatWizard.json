    {
      "parameters": {
        "jsCode": "\nconst item = $input.item;\n\n// Get the incoming binary data\nconst binary = item.binary ?? {};\nconst binaryKey = Object.keys(binary)[0];\n\nif (!binaryKey) {\n  throw new Error(\n    \"No binary file received. Check the Form Trigger output and Normalize Input node.\"\n  );\n}\n\nconst file = binary[binaryKey];\n\n// Detect the original filename and extension\nconst fileName = file.fileName || \"uploaded_file\";\n\nconst extensionMatch = fileName.match(/\\.([^.]+)$/);\n\nconst sourceFormat = String(\n  file.fileExtension ||\n  (extensionMatch ? extensionMatch[1] : \"\")\n).toLowerCase().replace(/^\\./, \"\");\n\n// Read the requested output format\nconst targetFormat = String(\n  item.json.target_format || \"\"\n).trim().toLowerCase().replace(/^\\./, \"\");\n\n// Supported formats\nconst supportedFormats = [\n  \"pdf\",\n  \"docx\",\n  \"xlsx\",\n  \"pptx\",\n  \"png\",\n  \"jpg\",\n  \"jpeg\",\n  \"txt\",\n  \"csv\"\n];\n\n// Validate source format\nif (!supportedFormats.includes(sourceFormat)) {\n  throw new Error(\n    `Unsupported input format: ${sourceFormat || \"unknown\"}`\n  );\n}\n\n// Validate target format\nif (!supportedFormats.includes(targetFormat)) {\n  throw new Error(\n    `Unsupported output format: ${targetFormat || \"not selected\"}`\n  );\n}\n\n// Prepare conversion plan\nconst conversionRequired = sourceFormat !== targetFormat;\n\nreturn {\n  json: {\n    ...item.json,\n    original_filename: fileName,\n    source_format: sourceFormat,\n    target_format: targetFormat,\n    conversion_key: `${sourceFormat}_to_${targetFormat}`,\n    conversion_required: conversionRequired,\n    processing_status: conversionRequired\n      ? \"READY_FOR_CONVERSION\"\n      : \"SAME_FORMAT\"\n  },\n  binary\n};\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
